<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ===================== Sparkline ===================== -->
    <t t-name="dmag_dashboard.Sparkline">
        <t t-set="g" t-value="geometry"/>
        <svg t-if="g" class="dmag-spark" t-att-class="'dmag-spark--' + (props.tone or 'neutral')"
             t-attf-viewBox="0 0 {{g.W}} {{g.H}}" preserveAspectRatio="none" aria-hidden="true">
            <polygon class="dmag-spark__area" t-att-points="g.area"/>
            <polyline class="dmag-spark__line" t-att-points="g.line"/>
            <circle class="dmag-spark__dot" t-att-cx="g.last[0]" t-att-cy="g.last[1]" r="3"/>
        </svg>
        <div t-else="" class="dmag-spark dmag-spark--empty"/>
    </t>

    <!-- ===================== Trend chart ===================== -->
    <t t-name="dmag_dashboard.TrendChart">
        <t t-set="m" t-value="model"/>
        <t t-set="tt" t-value="tooltip"/>
        <div class="dmag-trend">
            <svg t-ref="svg" class="dmag-trend__svg" t-attf-viewBox="0 0 {{W}} {{H}}"
                 t-on-mousemove="onMove" t-on-mouseleave="onLeave" role="img">
                <g class="dmag-trend__grid">
                    <t t-foreach="m.ticks" t-as="tick" t-key="tick_index">
                        <line t-att-x1="pad.l" t-att-x2="W - pad.r" t-att-y1="tick.y" t-att-y2="tick.y"/>
                        <text t-att-x="pad.l - 8" t-att-y="tick.y + 4" text-anchor="end" t-esc="tick.label"/>
                    </t>
                    <t t-foreach="m.xlabels" t-as="xl" t-key="xl.i">
                        <text t-att-x="xl.x" t-att-y="H - 8" text-anchor="middle" t-esc="xl.label"/>
                    </t>
                </g>
                <path class="dmag-trend__area" t-att-d="m.area"/>
                <path class="dmag-trend__prev" t-att-d="m.prev"/>
                <path class="dmag-trend__cur" t-att-d="m.cur"/>
                <circle t-if="m.end and state.hover === null" class="dmag-trend__end"
                        t-att-cx="m.end.x" t-att-cy="m.end.y" r="5"/>
                <g t-if="tt">
                    <line class="dmag-trend__cross" t-att-x1="tt.lx" t-att-x2="tt.lx" t-att-y1="pad.t" t-att-y2="H - pad.b"/>
                    <circle t-if="tt.py !== null" class="dmag-trend__pdot" t-att-cx="tt.lx" t-att-cy="tt.py" r="4"/>
                    <circle t-if="tt.cy !== null" class="dmag-trend__end" t-att-cx="tt.lx" t-att-cy="tt.cy" r="5"/>
                </g>
            </svg>
            <div t-if="tt" class="dmag-tooltip" t-att-class="{'dmag-tooltip--right': tt.alignRight}"
                 t-attf-style="left: {{tt.left}}">
                <div class="dmag-tooltip__title" t-esc="tt.label"/>
                <div class="dmag-tooltip__row"><span class="dmag-key dmag-key--cur"/>Kỳ này<b t-esc="tt.cur"/></div>
                <div class="dmag-tooltip__row"><span class="dmag-key dmag-key--prev"/>Kỳ trước<b t-esc="tt.prev"/></div>
            </div>
        </div>
    </t>

    <!-- ===================== Main board ===================== -->
    <t t-name="dmag_dashboard.LearningDeploy">
        <div class="o_action o_dmag h-100 overflow-auto">
            <!-- Header -->
            <header class="dmag-hero">
                <div class="dmag-hero__inner">
                    <div class="dmag-hero__brand">
                        <span class="dmag-logo">DMAG</span>
                        <div>
                            <div class="dmag-hero__eyebrow">Dashboard điều hành · Định Vị Mới</div>
                            <h1 class="dmag-hero__title">Học &amp; Triển khai SPDV</h1>
                        </div>
                    </div>
                    <div class="dmag-hero__controls">
                        <div class="dmag-seg" role="tablist" aria-label="Khoảng thời gian">
                            <t t-foreach="periods" t-as="p" t-key="p.value">
                                <button type="button" class="dmag-seg__btn"
                                        t-att-class="{'is-active': state.period === p.value}"
                                        t-att-aria-selected="state.period === p.value ? 'true' : 'false'"
                                        t-on-click="() => this.setPeriod(p.value)" t-esc="p.label"/>
                            </t>
                        </div>
                        <select class="dmag-select" t-on-change="setUser" aria-label="Người phụ trách">
                            <option value="0" t-att-selected="!state.userId">Tất cả phụ trách</option>
                            <t t-if="state.data">
                                <t t-foreach="state.data.users" t-as="u" t-key="u.id">
                                    <option t-att-value="u.id" t-att-selected="state.userId === u.id" t-esc="u.name"/>
                                </t>
                            </t>
                        </select>
                        <button type="button" class="dmag-icon-btn" t-on-click="() => this.load()" title="Làm mới">
                            <i class="fa fa-refresh" t-att-class="{'fa-spin': state.refreshing}"/>
                        </button>
                    </div>
                </div>
                <div t-if="state.data" class="dmag-hero__meta">
                    Cập nhật <t t-esc="updatedAt"/> · so sánh với <t t-esc="periodLabel"/> · tự làm mới mỗi 5 phút
                </div>
            </header>

            <div t-if="state.loading" class="dmag-body">
                <div class="dmag-skeleton-row">
                    <t t-foreach="[1,2,3,4,5,6]" t-as="i" t-key="i"><div class="dmag-card dmag-skeleton"/></t>
                </div>
            </div>
            <div t-elif="state.error" class="dmag-body">
                <div class="dmag-card dmag-error"><i class="fa fa-warning me-2"/><t t-esc="state.error"/></div>
            </div>
            <div t-else="" class="dmag-body" t-att-class="{'is-refreshing': state.refreshing}">
                <t t-set="d" t-value="state.data"/>

                <!-- Signals (GA-like insights) -->
                <section class="dmag-signals" t-if="d.signals.length" aria-label="Tín hiệu cần chú ý">
                    <div class="dmag-section-label"><i class="fa fa-bolt"/> Tín hiệu tự động
                        <span class="dmag-count" t-esc="d.signals.length"/></div>
                    <div class="dmag-signals__list">
                        <t t-foreach="signals" t-as="sig" t-key="sig_index">
                            <button type="button" class="dmag-signal" t-att-class="'dmag-signal--' + sig.severity"
                                    t-on-click="() => this.onSignal(sig)">
                                <i class="fa dmag-signal__icon" t-att-class="SEVERITY[sig.severity].icon"/>
                                <span class="dmag-signal__body">
                                    <span class="dmag-signal__title">
                                        <t t-esc="sig.title"/>
                                        <span class="dmag-signal__tag" t-esc="SEVERITY[sig.severity].label"/>
                                    </span>
                                    <span class="dmag-signal__msg" t-esc="sig.message"/>
                                </span>
                                <i class="fa fa-angle-right dmag-signal__go"/>
                            </button>
                        </t>
                    </div>
                    <button t-if="d.signals.length > 4" type="button" class="dmag-link-btn"
                            t-on-click="() => { this.state.allSignals = !this.state.allSignals }">
                        <t t-if="state.allSignals">Thu gọn</t>
                        <t t-else="">Xem thêm <t t-esc="d.signals.length - 4"/> tín hiệu</t>
                    </button>
                </section>
                <section t-else="" class="dmag-signals dmag-signals--calm">
                    <i class="fa fa-check-circle"/> Không có biến động bất thường — mọi chỉ số nằm trong dao động bình thường.
                </section>

                <!-- KPI row -->
                <section class="dmag-kpis" aria-label="Chỉ số chính">
                    <t t-foreach="d.kpis" t-as="kpi" t-key="kpi.key">
                        <button type="button" class="dmag-card dmag-kpi" t-att-class="'dmag-kpi--' + kpi.group"
                                t-on-click="() => this.drillKpi(kpi.key)" t-att-title="kpi.hint">
                            <span class="dmag-kpi__label">
                                <span class="dmag-kpi__group" t-esc="kpi.group === 'learn' ? 'Học' : kpi.group === 'deploy' ? 'Triển khai' : 'Bán'"/>
                                <t t-esc="kpi.label"/>
                            </span>
                            <span class="dmag-kpi__value" t-esc="kpiValue(kpi)"/>
                            <span class="dmag-kpi__row">
                                <span class="dmag-delta" t-att-class="'dmag-delta--' + kpi.tone">
                                    <i class="fa" t-att-class="deltaIcon(kpi)"/>
                                    <t t-if="kpi.delta !== null" t-esc="fmtDelta(kpi.delta, kpi.unit)"/>
                                    <t t-else="">mới</t>
                                </span>
                                <span class="dmag-kpi__prev">kỳ trước <t t-esc="fmtMetric(kpi.previous, kpi.unit)"/></span>
                            </span>
                            <Sparkline values="kpi.spark" tone="kpi.tone"/>
                            <span class="dmag-kpi__sub" t-esc="kpiSub(kpi)"/>
                        </button>
                    </t>
                </section>

                <!-- Journey funnel + trend -->
                <section class="dmag-grid dmag-grid--5-7">
                    <div class="dmag-card dmag-panel">
                        <div class="dmag-panel__head">
                            <div>
                                <h2>Hành trình khách hàng</h2>
                                <p>Khách ký hợp đồng SPDV trong kỳ đã đi tới đâu</p>
                            </div>
                        </div>
                        <div t-if="!d.funnel.stages[0].count" class="dmag-empty">Chưa có hợp đồng SPDV nào trong kỳ. Thử mở rộng khoảng thời gian.</div>
                        <ol t-else="" class="dmag-funnel">
                            <t t-foreach="d.funnel.stages" t-as="stage" t-key="stage.key">
                                <li>
                                    <button type="button" class="dmag-funnel__row" t-on-click="() => this.drillFunnel(stage)"
                                            t-att-disabled="!stage.count">
                                        <span class="dmag-funnel__label">
                                            <span class="dmag-funnel__step" t-esc="stage_index + 1"/>
                                            <t t-esc="stage.label"/>
                                        </span>
                                        <span class="dmag-funnel__track">
                                            <span class="dmag-funnel__bar" t-attf-style="width: {{Math.max(2, 100 * stage.count / maxFunnel)}}%"/>
                                        </span>
                                        <span class="dmag-funnel__num" t-esc="stage.count"/>
                                        <span class="dmag-funnel__pct">
                                            <t t-if="stage_index" t-esc="funnelConversion(stage_index) + '%'"/>
                                        </span>
                                    </button>
                                </li>
                            </t>
                        </ol>
                        <div class="dmag-speed">
                            <div class="dmag-speed__item" title="Trung bình số ngày từ ngày ký hợp đồng tới ngày bắt đầu dự án">
                                <span class="dmag-speed__val" t-esc="fmtDays(d.funnel.speed.kickoff_days)"/>
                                <span class="dmag-speed__lbl">Ký → Kick-off</span>
                            </div>
                            <div class="dmag-speed__item" title="Trung bình số ngày từ ngày ký tới khi học viên hoàn thành bài học đầu tiên">
                                <span class="dmag-speed__val" t-esc="fmtDays(d.funnel.speed.first_lesson_days)"/>
                                <span class="dmag-speed__lbl">Ký → Bài học đầu tiên</span>
                            </div>
                            <button type="button" class="dmag-speed__item" t-on-click="drillWaiting"
                                    t-att-class="{'is-alert': d.funnel.speed.waiting_kickoff.length}">
                                <span class="dmag-speed__val" t-esc="d.funnel.speed.waiting_kickoff.length"/>
                                <span class="dmag-speed__lbl">Chờ kick-off &gt; 7 ngày</span>
                            </button>
                        </div>
                    </div>

                    <div class="dmag-card dmag-panel">
                        <t t-set="tr" t-value="trend"/>
                        <div class="dmag-panel__head">
                            <div>
                                <h2>Nhịp vận hành</h2>
                                <p><t t-esc="tr.label"/> · kỳ này <b t-esc="fmtNum(tr.total)" t-if="tr.good !== 'down' and state.trendKey !== 'stalled' and state.trendKey !== 'overdue'"/>
                                    <t t-if="state.trendKey === 'stalled' or state.trendKey === 'overdue'">(số tồn tại cuối mỗi mốc)</t></p>
                            </div>
                            <div class="dmag-legend">
                                <span><span class="dmag-key dmag-key--cur"/>Kỳ này</span>
                                <span><span class="dmag-key dmag-key--prev"/>Kỳ trước</span>
                            </div>
                        </div>
                        <div class="dmag-tabs">
                            <t t-foreach="trendTabs" t-as="grp" t-key="grp.group">
                                <span class="dmag-tabs__group" t-esc="grp.group"/>
                                <t t-foreach="grp.items" t-as="it" t-key="it.key">
                                    <button type="button" class="dmag-tab" t-att-class="{'is-active': state.trendKey === it.key}"
                                            t-on-click="() => this.setTrend(it.key)" t-esc="it.label"/>
                                </t>
                            </t>
                        </div>
                        <TrendChart labels="d.buckets" current="tr.current" previous="tr.previous" monthly="tr.monthly"/>
                    </div>
                </section>

                <!-- Hotspots -->
                <section class="dmag-card dmag-panel">
                    <div class="dmag-panel__head">
                        <div>
                            <h2>Điểm nóng khách hàng</h2>
                            <p>Khách đang học hoặc đang triển khai, xếp theo điểm sức khỏe thấp nhất · bấm để xem hồ sơ 360°</p>
                        </div>
                        <div class="dmag-health-summary">
                            <span class="dmag-pill dmag-pill--risk"><i class="fa fa-exclamation-triangle"/> <t t-esc="d.health_summary.risk"/> Nguy cơ</span>
                            <span class="dmag-pill dmag-pill--watch"><i class="fa fa-exclamation-circle"/> <t t-esc="d.health_summary.watch"/> Cần chú ý</span>
                            <span class="dmag-pill dmag-pill--good"><i class="fa fa-check-circle"/> <t t-esc="d.health_summary.good"/> Tốt</span>
                        </div>
                    </div>
                    <div t-if="!d.customers.length" class="dmag-empty">Chưa có khách hàng nào đang học hoặc triển khai.</div>
                    <div t-else="" class="dmag-table-wrap">
                        <table class="dmag-table">
                            <thead>
                                <tr>
                                    <th>Khách hàng</th>
                                    <th class="text-center">Sức khỏe</th>
                                    <th>Tiến độ học</th>
                                    <th>Tiến độ triển khai</th>
                                    <th class="text-end">Quá hạn</th>
                                    <th class="text-end">Ngưng học</th>
                                    <th>Hoạt động cuối</th>
                                    <th>Vì sao</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="customers" t-as="c" t-key="c.id">
                                    <tr class="is-clickable" t-on-click="() => this.openCustomer(c.id)">
                                        <td>
                                            <div class="dmag-strong" t-esc="c.name"/>
                                            <div class="dmag-muted" t-if="c.salesperson">KD: <t t-esc="c.salesperson"/></div>
                                        </td>
                                        <td class="text-center">
                                            <span class="dmag-score" t-att-class="'dmag-score--' + c.level" t-att-title="LEVEL[c.level].label">
                                                <i class="fa" t-att-class="LEVEL[c.level].icon"/> <t t-esc="c.score"/>
                                            </span>
                                        </td>
                                        <td>
                                            <div t-if="c.learn_pct !== null" class="dmag-meter">
                                                <span class="dmag-meter__track"><span class="dmag-meter__fill" t-attf-style="width: {{c.learn_pct}}%"/></span>
                                                <span class="dmag-meter__val"><t t-esc="c.learn_pct"/>%</span>
                                            </div>
                                            <div class="dmag-muted" t-if="c.learners"><t t-esc="c.learners"/> học viên</div>
                                            <div class="dmag-muted" t-else="">Chưa ghi danh</div>
                                        </td>
                                        <td>
                                            <div t-if="c.deploy_pct !== null" class="dmag-meter dmag-meter--deploy">
                                                <span class="dmag-meter__track"><span class="dmag-meter__fill" t-attf-style="width: {{c.deploy_pct}}%"/></span>
                                                <span class="dmag-meter__val"><t t-esc="c.deploy_pct"/>%</span>
                                            </div>
                                            <div class="dmag-muted" t-if="c.tasks_total"><t t-esc="c.tasks_closed"/>/<t t-esc="c.tasks_total"/> đầu việc</div>
                                            <div class="dmag-muted" t-else="">Chưa kick-off</div>
                                        </td>
                                        <td class="text-end dmag-num" t-att-class="{'dmag-bad': c.overdue}" t-esc="c.overdue or '—'"/>
                                        <td class="text-end dmag-num" t-att-class="{'dmag-bad': c.stalled}" t-esc="c.stalled or '—'"/>
                                        <td class="dmag-muted" t-esc="fmtAgo(c.idle_days)"/>
                                        <td>
                                            <t t-foreach="c.reasons.slice(0, 2)" t-as="r" t-key="r_index">
                                                <span class="dmag-chip" t-att-class="'dmag-chip--' + r.tone" t-esc="r.text"/>
                                            </t>
                                            <span t-if="c.reasons.length > 2" class="dmag-chip">+<t t-esc="c.reasons.length - 2"/></span>
                                            <span t-if="!c.reasons.length" class="dmag-muted">Ổn định</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <button t-if="d.customers.length > 8" type="button" class="dmag-link-btn"
                                t-on-click="() => { this.state.allCustomers = !this.state.allCustomers }">
                            <t t-if="state.allCustomers">Thu gọn</t>
                            <t t-else="">Xem tất cả <t t-esc="d.customers.length"/> khách hàng</t>
                        </button>
                    </div>
                </section>

                <!-- Courses + team -->
                <section class="dmag-grid dmag-grid--6-6">
                    <div class="dmag-card dmag-panel">
                        <div class="dmag-panel__head">
                            <div>
                                <h2>Khóa học &amp; chương trình</h2>
                                <p>Bấm khóa học để xem từng học viên</p>
                            </div>
                        </div>
                        <div t-if="!d.courses.length" class="dmag-empty">Chưa có học viên ghi danh.</div>
                        <div t-else="" class="dmag-table-wrap">
                            <table class="dmag-table">
                                <thead><tr>
                                    <th>Khóa học</th>
                                    <th class="text-end">Đang học</th>
                                    <th>Hoàn thành TB</th>
                                    <th class="text-end">Ngưng</th>
                                    <th class="text-end">Bài xong kỳ này</th>
                                </tr></thead>
                                <tbody>
                                    <t t-foreach="d.courses" t-as="co" t-key="co.id">
                                        <tr class="is-clickable" t-on-click="() => this.openCourse(co.id)">
                                            <td>
                                                <div class="dmag-strong" t-esc="co.name"/>
                                                <div class="dmag-muted"><t t-esc="co.enrolled"/> ghi danh · <t t-esc="co.completed"/> hoàn thành<t t-if="co.new"> · +<t t-esc="co.new"/> mới</t></div>
                                            </td>
                                            <td class="text-end dmag-num" t-esc="co.active"/>
                                            <td>
                                                <div class="dmag-meter">
                                                    <span class="dmag-meter__track"><span class="dmag-meter__fill" t-attf-style="width: {{co.avg_completion}}%"/></span>
                                                    <span class="dmag-meter__val"><t t-esc="co.avg_completion"/>%</span>
                                                </div>
                                            </td>
                                            <td class="text-end dmag-num" t-att-class="{'dmag-bad': co.stalled}" t-esc="co.stalled or '—'"/>
                                            <td class="text-end dmag-num" t-esc="fmtNum(co.lessons)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="dmag-card dmag-panel">
                        <div class="dmag-panel__head">
                            <div>
                                <h2>Đội triển khai</h2>
                                <p>Tải việc &amp; kỷ luật deadline · bấm để mở danh sách việc</p>
                            </div>
                        </div>
                        <div t-if="!d.team.length" class="dmag-empty">Chưa có đầu việc triển khai.</div>
                        <div t-else="" class="dmag-table-wrap">
                            <table class="dmag-table">
                                <thead><tr>
                                    <th>Phụ trách</th>
                                    <th class="text-end">Đang mở</th>
                                    <th class="text-end">Quá hạn</th>
                                    <th class="text-end">Xong kỳ này</th>
                                    <th class="text-end">Đúng hạn</th>
                                </tr></thead>
                                <tbody>
                                    <t t-foreach="d.team" t-as="m" t-key="m.id">
                                        <tr class="is-clickable" t-on-click="() => this.drill({type: 'user', id: m.id})">
                                            <td>
                                                <span class="dmag-avatar" t-att-class="{'dmag-avatar--empty': !m.id}">
                                                    <t t-if="m.id" t-esc="(m.name || '?').split(' ').slice(-1)[0][0]"/>
                                                    <i t-else="" class="fa fa-user-times"/>
                                                </span>
                                                <span class="dmag-strong" t-att-class="{'dmag-bad': !m.id}" t-esc="m.name"/>
                                            </td>
                                            <td class="text-end dmag-num" t-esc="m.open"/>
                                            <td class="text-end dmag-num" t-att-class="{'dmag-bad': m.overdue}" t-esc="m.overdue or '—'"/>
                                            <td class="text-end dmag-num" t-esc="m.done"/>
                                            <td class="text-end dmag-num">
                                                <span t-if="m.ontime_rate !== null" class="dmag-rate"
                                                      t-att-class="m.ontime_rate >= 85 ? 'dmag-good' : m.ontime_rate >= 65 ? 'dmag-warn' : 'dmag-bad'"
                                                      t-esc="m.ontime_rate + '%'"/>
                                                <span t-else="" class="dmag-muted">—</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- Glossary -->
                <section class="dmag-glossary">
                    <button type="button" class="dmag-link-btn" t-on-click="() => { this.state.glossary = !this.state.glossary }">
                        <i class="fa fa-book me-1"/> Cách tính các chỉ số <i class="fa" t-att-class="state.glossary ? 'fa-angle-up' : 'fa-angle-down'"/>
                    </button>
                    <dl t-if="state.glossary" class="dmag-glossary__list">
                        <t t-foreach="d.glossary" t-as="g" t-key="g.key">
                            <div><dt t-esc="g.label"/><dd t-esc="g.hint"/></div>
                        </t>
                        <div><dt>Điểm sức khỏe</dt><dd>100 điểm, trừ: 6/đầu việc quá hạn (tối đa 36), 8/học viên ngưng học (tối đa 32), 10/mốc nghiệm thu trễ, 10–20 theo trạng thái dự án báo cáo, 15 nếu không hoạt động quá <t t-esc="d.settings.idle_days"/> ngày. ≥75 Tốt · 50–74 Cần chú ý · &lt;50 Nguy cơ.</dd></div>
                        <div><dt>Ngưng học</dt><dd>Ngưỡng hiện tại: <t t-esc="d.settings.stall_days"/> ngày (đổi trong Cấu hình).</dd></div>
                    </dl>
                </section>
            </div>

            <DetailDrawer t-if="state.drawer" kind="state.drawer.kind" id="state.drawer.id" params="params"
                          onClose.bind="closeDrawer" onDrill.bind="drill" onOpenCustomer.bind="openCustomer"/>
        </div>
    </t>

    <!-- ===================== Drawer (level-2 drill-down) ===================== -->
    <t t-name="dmag_dashboard.DetailDrawer">
        <div class="dmag-drawer" t-on-keydown="onKeydown">
            <div class="dmag-drawer__scrim" t-on-click="props.onClose"/>
            <aside class="dmag-drawer__panel" role="dialog" aria-modal="true" tabindex="-1">
                <button type="button" class="dmag-drawer__close" t-on-click="props.onClose" title="Đóng (Esc)"><i class="fa fa-times"/></button>
                <div t-if="state.loading" class="dmag-drawer__loading"><i class="fa fa-circle-o-notch fa-spin"/></div>
                <t t-else="">
                    <t t-set="d" t-value="state.data"/>

                    <!-- Customer 360 -->
                    <t t-if="props.kind === 'customer'">
                        <div class="dmag-drawer__head">
                            <div class="dmag-hero__eyebrow">Hồ sơ khách hàng 360°</div>
                            <h2 t-esc="d.name"/>
                            <div class="dmag-muted">
                                <t t-if="d.salesperson">Kinh doanh: <t t-esc="d.salesperson"/></t>
                                <t t-if="d.phone"> · <t t-esc="d.phone"/></t>
                                <t t-if="d.email"> · <t t-esc="d.email"/></t>
                            </div>
                            <button type="button" class="dmag-btn" t-on-click="() => this.open('res.partner', d.id)">
                                <i class="fa fa-external-link me-1"/> Mở hồ sơ trong Odoo
                            </button>
                        </div>
                        <div t-if="d.health" class="dmag-drawer__health">
                            <div class="dmag-gauge" t-att-class="'dmag-gauge--' + d.health.level">
                                <span class="dmag-gauge__num" t-esc="d.health.score"/>
                                <span class="dmag-gauge__lbl"><i class="fa" t-att-class="LEVEL[d.health.level].icon"/> <t t-esc="LEVEL[d.health.level].label"/></span>
                            </div>
                            <div class="dmag-drawer__stats">
                                <div><b><t t-esc="d.health.learn_pct === null ? '—' : d.health.learn_pct + '%'"/></b><span>Hoàn thành học</span></div>
                                <div><b><t t-esc="d.health.deploy_pct === null ? '—' : d.health.deploy_pct + '%'"/></b><span>Tiến độ triển khai</span></div>
                                <div><b t-att-class="{'dmag-bad': d.health.overdue}" t-esc="d.health.overdue"/><span>Việc quá hạn</span></div>
                                <div><b t-att-class="{'dmag-bad': d.health.stalled}" t-esc="d.health.stalled"/><span>Ngưng học</span></div>
                            </div>
                            <div class="dmag-drawer__reasons">
                                <t t-foreach="d.health.reasons" t-as="r" t-key="r_index">
                                    <span class="dmag-chip" t-att-class="'dmag-chip--' + r.tone" t-esc="r.text"/>
                                </t>
                            </div>
                        </div>
                        <div t-else="" class="dmag-empty">Khách hàng hiện không có hoạt động học/triển khai đang mở.</div>

                        <h3>Học viên <span class="dmag-count" t-esc="d.learners.length"/></h3>
                        <div t-if="!d.learners.length" class="dmag-empty">Chưa có học viên ghi danh.</div>
                        <ul t-else="" class="dmag-list">
                            <t t-foreach="d.learners" t-as="l" t-key="l.id">
                                <li class="is-clickable" t-on-click="() => this.open('slide.channel.partner', l.id)">
                                    <div class="dmag-list__main">
                                        <div class="dmag-strong"><t t-esc="l.name"/>
                                            <span t-if="l.stalled" class="dmag-chip dmag-chip--bad">Ngưng <t t-esc="l.idle_days"/> ngày</span></div>
                                        <div class="dmag-muted"><t t-esc="l.course"/> · <t t-esc="ENROLL_STATUS[l.status]"/> · hoạt động <t t-esc="fmtAgo(l.idle_days)"/></div>
                                    </div>
                                    <div class="dmag-meter dmag-meter--sm">
                                        <span class="dmag-meter__track"><span class="dmag-meter__fill" t-attf-style="width: {{l.completion}}%"/></span>
                                        <span class="dmag-meter__val"><t t-esc="l.completion"/>%</span>
                                    </div>
                                </li>
                            </t>
                        </ul>

                        <h3>Dự án triển khai <span class="dmag-count" t-esc="d.projects.length"/></h3>
                        <div t-if="!d.projects.length" class="dmag-empty">Chưa kick-off dự án.</div>
                        <ul t-else="" class="dmag-list">
                            <t t-foreach="d.projects" t-as="p" t-key="p.id">
                                <li class="is-clickable" t-on-click="() => this.props.onDrill({type: 'project', id: p.id, title: p.name})">
                                    <div class="dmag-list__main">
                                        <div class="dmag-strong"><t t-esc="p.name"/>
                                            <span class="dmag-chip" t-att-class="'dmag-status--' + p.status" t-esc="p.status_label"/></div>
                                        <div class="dmag-muted">
                                            <t t-if="p.manager">PM: <t t-esc="p.manager"/> · </t>
                                            <t t-esc="p.closed"/>/<t t-esc="p.total"/> đầu việc
                                            <t t-if="p.next_milestone"> · Mốc tới: <t t-esc="p.next_milestone.name"/>
                                                (<span t-att-class="{'dmag-bad': p.next_milestone.late}" t-esc="fmtDate(p.next_milestone.deadline + ' 00:00:00')"/>)</t>
                                            <span t-if="p.late_milestones" class="dmag-bad"> · <t t-esc="p.late_milestones"/> mốc trễ</span>
                                        </div>
                                    </div>
                                    <div class="dmag-meter dmag-meter--sm dmag-meter--deploy">
                                        <span class="dmag-meter__track"><span class="dmag-meter__fill" t-attf-style="width: {{p.pct}}%"/></span>
                                        <span class="dmag-meter__val"><t t-esc="p.pct"/>%</span>
                                    </div>
                                </li>
                            </t>
                        </ul>

                        <h3>Đầu việc đang mở <span class="dmag-count" t-esc="d.tasks.length"/></h3>
                        <div t-if="!d.tasks.length" class="dmag-empty">Không có đầu việc mở.</div>
                        <ul t-else="" class="dmag-list">
                            <t t-foreach="d.tasks" t-as="t" t-key="t.id">
                                <li class="is-clickable" t-on-click="() => this.open('project.task', t.id)">
                                    <div class="dmag-list__main">
                                        <div class="dmag-strong" t-esc="t.name"/>
                                        <div class="dmag-muted"><t t-esc="t.project"/><t t-if="t.stage"> · <t t-esc="t.stage"/></t><t t-if="t.users"> · <t t-esc="t.users"/></t></div>
                                    </div>
                                    <span t-if="t.late_days" class="dmag-chip dmag-chip--bad">Trễ <t t-esc="t.late_days"/> ngày</span>
                                    <span t-elif="t.deadline" class="dmag-muted" t-esc="fmtDate(t.deadline)"/>
                                    <span t-else="" class="dmag-muted">Không deadline</span>
                                </li>
                            </t>
                        </ul>

                        <h3>Hợp đồng SPDV <span class="dmag-count" t-esc="d.orders.length"/></h3>
                        <ul class="dmag-list">
                            <t t-foreach="d.orders" t-as="o" t-key="o.id">
                                <li class="is-clickable" t-on-click="() => this.open('sale.order', o.id)">
                                    <div class="dmag-list__main">
                                        <div class="dmag-strong" t-esc="o.name"/>
                                        <div class="dmag-muted" t-esc="fmtDate(o.date, true)"/>
                                    </div>
                                    <span class="dmag-num" t-esc="fmtCompact(o.amount)"/>
                                </li>
                            </t>
                        </ul>
                    </t>

                    <!-- Course detail -->
                    <t t-else="">
                        <div class="dmag-drawer__head">
                            <div class="dmag-hero__eyebrow">Khóa học</div>
                            <h2 t-esc="d.name"/>
                            <div class="dmag-muted"><t t-esc="d.total_slides"/> bài học<t t-if="d.responsible"> · Phụ trách: <t t-esc="d.responsible"/></t></div>
                            <button type="button" class="dmag-btn" t-on-click="() => this.props.onDrill({type: 'course', id: d.id, title: d.name})">
                                <i class="fa fa-list me-1"/> Danh sách học viên trong Odoo
                            </button>
                        </div>
                        <h3>Học viên <span class="dmag-count" t-esc="d.learners.length"/></h3>
                        <ul class="dmag-list">
                            <t t-foreach="d.learners" t-as="l" t-key="l.id">
                                <li class="is-clickable" t-on-click="() => this.open('slide.channel.partner', l.id)">
                                    <div class="dmag-list__main">
                                        <div class="dmag-strong"><t t-esc="l.name"/>
                                            <span t-if="l.stalled" class="dmag-chip dmag-chip--bad">Ngưng <t t-esc="l.idle_days"/> ngày</span></div>
                                        <div class="dmag-muted">
                                            <a href="#" t-on-click.prevent.stop="() => this.props.onOpenCustomer(l.customer_id)" t-esc="l.customer"/>
                                            · <t t-esc="ENROLL_STATUS[l.status]"/> · hoạt động <t t-esc="fmtAgo(l.idle_days)"/>
                                        </div>
                                    </div>
                                    <div class="dmag-meter dmag-meter--sm">
                                        <span class="dmag-meter__track"><span class="dmag-meter__fill" t-attf-style="width: {{l.completion}}%"/></span>
                                        <span class="dmag-meter__val"><t t-esc="l.completion"/>%</span>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </t>
                </t>
            </aside>
        </div>
    </t>
</templates>
