<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One generic client action per board: the board key selects the backend model dmag.board.<key> -->
    <record id="action_dmag_board_executive" model="ir.actions.client">
        <field name="name">Tổng quan điều hành</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'executive'}"/>
    </record>
    <record id="action_dmag_board_sales" model="ir.actions.client">
        <field name="name">Kinh doanh</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'sales'}"/>
    </record>
    <record id="action_dmag_board_marketing" model="ir.actions.client">
        <field name="name">Marketing</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'marketing'}"/>
    </record>
    <record id="action_dmag_learning_deploy" model="ir.actions.client">
        <field name="name">Học &amp; Triển khai SPDV</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'learning'}"/>
    </record>
    <record id="action_dmag_board_finance" model="ir.actions.client">
        <field name="name">Tài chính</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'finance'}"/>
    </record>
    <record id="action_dmag_board_hr" model="ir.actions.client">
        <field name="name">Nhân sự</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'hr'}"/>
    </record>
    <record id="action_dmag_board_ops" model="ir.actions.client">
        <field name="name">Mua hàng &amp; Kho</field>
        <field name="tag">dmag_dashboard.board</field>
        <field name="params" eval="{'board': 'ops'}"/>
    </record>

    <menuitem id="menu_dmag_root" name="Điều hành DMAG" sequence="1"
              web_icon="dmag_dashboard,static/description/icon.png"
              groups="group_dmag_dashboard_user"/>
    <menuitem id="menu_dmag_board_executive" name="Tổng quan" parent="menu_dmag_root" sequence="1"
              action="action_dmag_board_executive" groups="group_dmag_role_exec"/>
    <menuitem id="menu_dmag_board_sales" name="Kinh doanh" parent="menu_dmag_root" sequence="2"
              action="action_dmag_board_sales" groups="group_dmag_role_sales"/>
    <menuitem id="menu_dmag_board_marketing" name="Marketing" parent="menu_dmag_root" sequence="3"
              action="action_dmag_board_marketing" groups="group_dmag_role_marketing"/>
    <menuitem id="menu_dmag_learning_deploy" name="Học &amp; Triển khai" parent="menu_dmag_root" sequence="4"
              action="action_dmag_learning_deploy" groups="group_dmag_role_delivery"/>
    <menuitem id="menu_dmag_board_finance" name="Tài chính" parent="menu_dmag_root" sequence="5"
              action="action_dmag_board_finance" groups="group_dmag_role_finance"/>
    <menuitem id="menu_dmag_board_hr" name="Nhân sự" parent="menu_dmag_root" sequence="6"
              action="action_dmag_board_hr" groups="group_dmag_role_hr"/>
    <menuitem id="menu_dmag_board_ops" name="Mua hàng &amp; Kho" parent="menu_dmag_root" sequence="7"
              action="action_dmag_board_ops" groups="group_dmag_role_ops"/>

    <menuitem id="menu_dmag_alerts" name="Cảnh báo" parent="menu_dmag_root" sequence="20"/>
    <menuitem id="menu_dmag_alert_log" parent="menu_dmag_alerts" sequence="1" action="action_dmag_alert"/>
    <menuitem id="menu_dmag_alert_rules" parent="menu_dmag_alerts" sequence="2" action="action_dmag_alert_rule"
              groups="group_dmag_dashboard_manager"/>
    <menuitem id="menu_dmag_config" name="Cấu hình" parent="menu_dmag_root" sequence="90"
              groups="group_dmag_dashboard_manager"/>
    <menuitem id="menu_dmag_settings" parent="menu_dmag_config" sequence="1" action="action_dmag_settings"/>
</odoo>
